rules_version = '2';

// IVORY — Firestore security rules.
// Public storefront (signed out) may only READ content collections and
// CREATE orders. Any signed-in staff account may read/write all content —
// there is a single staff tier, no admin/editor distinction.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Public read, staff write — every storefront content collection.
    match /products/{docId} { allow read: if true; allow write: if signedIn(); }
    match /categories/{docId} { allow read: if true; allow write: if signedIn(); }
    match /activities/{docId} { allow read: if true; allow write: if signedIn(); }
    match /promoTiles/{docId} { allow read: if true; allow write: if signedIn(); }
    match /faqs/{docId} { allow read: if true; allow write: if signedIn(); }
    match /pages/{docId} { allow read: if true; allow write: if signedIn(); }
    match /siteContent/{docId} { allow read: if true; allow write: if signedIn(); }
    match /settings/{docId} { allow read: if true; allow write: if signedIn(); }
    match /promoCodes/{docId} { allow read: if true; allow write: if signedIn(); }

    // Orders: anyone can create a checkout inquiry; only staff can read or manage the list.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if signedIn();
    }

    // Profiles: the staff directory (Staff screen). Any signed-in staff
    // member can read/create/remove any profile — creating a staff login
    // writes the new user's profile doc directly from the creating admin's
    // session, since the new account isn't signed in yet.
    match /profiles/{uid} {
      allow read, write: if signedIn();
    }
  }
}
